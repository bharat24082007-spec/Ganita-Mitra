# Copy this file to backend\.env and fill in real values. Never commit backend\.env.
# Placeholders below are NOT real values. Variables already set in the real environment take precedence.

# Gemini API key for the AI tutor. Required for the tutor; if missing, the tutor returns 503.
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name used by the tutor. Required for the tutor; if missing, the tutor returns 503.
MODEL_NAME=your-gemini-model-name

# Secret used to sign student and parent session tokens. Required for signed-in routes; if missing, those routes return 503.
# Use a long random string, e.g. 64+ characters.
SESSION_SECRET=replace-with-a-long-random-string

# One-time token that authorises parent/teacher account setup (POST /api/parents/setup). Required only for setup; if missing, setup returns 503.
PARENT_SETUP_TOKEN=replace-with-a-setup-token

# SQLite database file path. Optional; default is backend/data/tutor.db relative to the working directory.
# Known limitation: this is read when the backend starts, before .env is loaded, so setting it here is ignored.
# To change it, set DATABASE_PATH in the real environment instead.
# DATABASE_PATH=backend/data/tutor.db
